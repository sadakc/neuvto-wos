{
  // Terminal → Run Task… lists these. Every one runs against this Mac only;
  // nothing here deploys or touches the live site.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Start the local database (Docker)",
      "type": "shell",
      "command": "supabase start",
      "problemMatcher": []
    },
    {
      "label": "2. Run the app (localhost:8080)",
      "type": "shell",
      "command": "bun run dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Checks: lint, types, unit tests",
      "type": "shell",
      "command": "bun run lint && bun run typecheck && bun run test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Checks: SQL harness",
      "type": "shell",
      "command": "bun run harness",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Checks: browser tests",
      "type": "shell",
      "command": "bun run e2e",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Checks: browser tests, watching",
      "type": "shell",
      "command": "bun run e2e:ui",
      "problemMatcher": []
    },
    {
      "label": "Checks: mutation test the open file",
      "type": "shell",
      "command": "bun run mutate ${relativeFile}",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Checks: formatting",
      "type": "shell",
      "command": "bun run format:check",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Database: rebuild from the migrations",
      "type": "shell",
      "command": "supabase db reset --local",
      "problemMatcher": []
    },
    {
      "label": "Design: regenerate tokens",
      "type": "shell",
      "command": "bun run tokens",
      "problemMatcher": []
    }
  ]
}
