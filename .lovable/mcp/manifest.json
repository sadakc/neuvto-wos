{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://vkyvzhgigncranprhidn.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "neuvto-mcp",
      "version": "0.1.0",
      "title": "Neuvto WOS"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Who am I",
        "description": "Return the signed-in Neuvto user (id + email) for the current MCP session.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "submit_demo_request",
        "title": "Submit demo request",
        "description": "Create a new Neuvto demo/lead request on behalf of the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Contact name for the lead."
            },
            "email": {
              "type": "string",
              "format": "email",
              "maxLength": 200,
              "description": "Contact email for the lead."
            },
            "company": {
              "type": "string",
              "maxLength": 200,
              "description": "Company name (optional)."
            },
            "employees": {
              "type": "string",
              "maxLength": 50,
              "description": "Employee count / band (optional)."
            },
            "message": {
              "type": "string",
              "maxLength": 2000,
              "description": "Notes about the request (optional)."
            }
          },
          "required": [
            "name",
            "email"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
