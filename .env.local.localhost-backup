# Local development only. Points the app at the local Supabase stack started by
# `supabase start`, instead of the hosted Lovable Cloud database that .env
# configures.
#
# Without this, `bun run dev` talks to the SHARED hosted database: sign-up
# creates real users there and Supabase attempts real OTP emails. Vite gives
# .env.local precedence over .env, and *.local is gitignored, so this file stays
# on your machine.
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH"
VITE_SUPABASE_PROJECT_ID="local-dev"
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH"
