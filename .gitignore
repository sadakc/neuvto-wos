# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
# The netlify preset writes here. Absent until 6 Aug 2026, when a build run to
# prove the preset worked was committed by `git add -A` — 100+ artefacts into a
# docs PR, because the other three build directories were listed and this one
# was not.
.netlify
.vinxi
.tanstack/**
.nitro

# Local environment. `.env` itself IS committed and holds only publishable
# values; everything machine-specific goes in a .env.local* file.
#
# `*.local` alone was not enough: scripts/dev-lan.sh writes
# .env.local.localhost-backup, which does not end in `.local`, and it was
# committed in eba35e1 before anyone noticed. Match the prefix, not the suffix.
*.local
.env.local*

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Supabase local scratch
supabase/.branches
supabase/.temp
